#!/bin/bash
# Qwen3-30B-A3B train/rollout logp-diff alignment run on GB200 (aarch64).
#   MODE=det   -> full alignment stack (target: train_rollout_logprob_abs_diff < 1e-6)
#   MODE=bf16  -> same workload, no alignment stack (control / cheaper bring-up)
# Usage:
#   sbatch --nodes=1 jobs/run_det.job bf16          # smoke first
#   SLIME_E2E_SHAPE=1 NUM_ROLLOUT=1 sbatch --nodes=1 jobs/run_det.job det
#   NNODES=2 sbatch --nodes=2 jobs/run_det.job det  # customer's exact EP8 shape
#SBATCH --account=general_sa
#SBATCH --exclusive
#SBATCH --partition=batch,36x2-a01r,tcpo
#SBATCH --job-name=general_sa-infix:slime-nvfp4
#SBATCH --ntasks-per-node=1
#SBATCH --time=4:00:00
#SBATCH --output=/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/investigation/nvfp4_dq_backward_20260911_v1/formal/logs/%j.out
#SBATCH --error=/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/investigation/nvfp4_dq_backward_20260911_v1/formal/logs/%j.err
#SBATCH --nodes=4
#SBATCH --cpus-per-task=64

set -euo pipefail
set -x
export PYTHONUNBUFFERED=1
export NVIDIA_DRIVER_CAPABILITIES=compute,utility
export NVIDIA_VISIBLE_DEVICES=all

MODE="${1:-${MODE:-det}}"
INFIX=/lustre/fsw/general_sa/shuazhang/python_space/infix.AI
W=/lustre/fsw/general_sa/shuazhang/python_space/verl_for_nvfp4_20251031/investigation/nvfp4_dq_backward_20260911_v1/formal
# Prefer the v2 image (use_fabric patch baked in); fall back to v1 + file overlay.
IMGDIR=/lustre/fsw/general_sa/shuazhang/images
if [ -z "${IMG:-}" ]; then
  if [ -f "$IMGDIR/slime-nvfp4-det-gb200-20260905-v6.sqsh" ]; then
    IMG="$IMGDIR/slime-nvfp4-det-gb200-20260905-v6.sqsh"
  else
    IMG="$IMGDIR/slime-nvfp4-det-gb200-20260905-v6.sqsh"
  fi
fi
# Bind the staged slime tree over the image copy so code tweaks need no rebuild.
MOUNTS="/lustre/fsw/general_sa/shuazhang:/lustre/fsw/general_sa/shuazhang,/home/shuazhang/.netrc:/root/.netrc,$W/slime_nvfp4:/root/slime"
EXP="${EXP:-gb200_30B_det_${MODE}_0904}"
PREP="source $W/jobs/nvfp4_prep_env.sh"

[ -f "$IMG" ] || { echo "FATAL: image not built yet: $IMG" >&2; exit 2; }

# Diagnostic full-Adam checkpoints are retained; no pruning process.

nodes=$(scontrol show hostnames "$SLURM_JOB_NODELIST"); nodes_array=( $nodes )
node_1=${nodes_array[0]}; ip=$node_1; port=6379; ip_head=$ip:$port
NNODES=$SLURM_JOB_NUM_NODES
GPUS_PER_NODE=4

# Env that must exist identically on head, workers AND driver (see det_prep_env.sh).
COMMON_EXPORTS="export MODE=$MODE EXP=$EXP NNODES=$NNODES GPUS_PER_NODE=$GPUS_PER_NODE \
 WANDB_ID=${WANDB_ID:-$EXP} WANDB_MODE=${WANDB_MODE:-online} \
 WANDB_RESUME_POLICY=${WANDB_RESUME_POLICY:-allow} \
 SGLANG_KV_CACHE_DTYPE=${SGLANG_KV_CACHE_DTYPE:-bfloat16} \
 SGLANG_MASKED_GEMM_FAST_ACT=${SGLANG_MASKED_GEMM_FAST_ACT:-0} \
 QWEN3_MOE_ALIGNED_SPEC=${QWEN3_MOE_ALIGNED_SPEC:-1} \
 SLIME_ROUTE_DEBUG=${SLIME_ROUTE_DEBUG:-} \
 SLIME_NAN_PROBE=${SLIME_NAN_PROBE:-0} \
 SLIME_MOE_POISON=${SLIME_MOE_POISON:-} \
 SLIME_ZERO_QUANT_SCALE=${SLIME_ZERO_QUANT_SCALE:-0} \
 CLB=${CLB:-1} \
 SLIME_MOE_SYNC_AT=${SLIME_MOE_SYNC_AT:-} \
 RM_TYPE=${RM_TYPE:-math} NO_SAVE_OPTIM=${NO_SAVE_OPTIM:-} EVAL_MAX_RESPONSE_LEN=${EVAL_MAX_RESPONSE_LEN:-8192} SLIME_PRE_MCORE_014=${SLIME_PRE_MCORE_014:-0} \
 AUDIT_VARIANT=fixed DQ_VARIANT=${DQ_VARIANT:?} AUDIT_OUT=$W/results/$EXP \
 NVFP4_MAX_M=64 SGLANG_NVFP4_PERTOKEN_SCALE=1 \
 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1"

echo "=== ray HEAD on $node_1 (MODE=$MODE EXP=$EXP NNODES=$NNODES) ==="
srun --nodes=1 --ntasks=1 -w "$node_1" --container-image="$IMG" --container-mounts="$MOUNTS" \
     --container-name=slime_nvfp4_$MODE --no-container-entrypoint bash -c \
  "$COMMON_EXPORTS ; $PREP && exec ray start --head --node-ip-address=$ip --port=$port --num-gpus $GPUS_PER_NODE --num-cpus 16 --dashboard-host=0.0.0.0 --disable-usage-stats --block" &
sleep 30

for ((i=1;i<NNODES;i++)); do
  echo "=== ray WORKER on ${nodes_array[$i]} ==="
  srun --nodes=1 --ntasks=1 -w "${nodes_array[$i]}" --container-image="$IMG" --container-mounts="$MOUNTS" \
       --no-container-entrypoint bash -c \
    "$COMMON_EXPORTS ; $PREP && exec ray start --address $ip_head --num-gpus $GPUS_PER_NODE --num-cpus 16 --disable-usage-stats --block" &
  sleep 5
done
sleep 30

echo "=== DRIVER on $node_1 ==="
srun --overlap --nodes=1 --ntasks=1 -w "$node_1" --container-image="$IMG" --container-mounts="$MOUNTS" \
     --container-name=slime_nvfp4_${MODE}_drv --no-container-entrypoint bash -c \
  "$COMMON_EXPORTS RAY_ADDRESS=$ip_head \
   SLIME_E2E_SHAPE=${SLIME_E2E_SHAPE:-0} NUM_ROLLOUT=${NUM_ROLLOUT:-3000} \
   ENABLE_EVAL=${ENABLE_EVAL:-0} CI_TEST=${CI_TEST:-0} \
   SAVE_INTERVAL=${SAVE_INTERVAL:-1000000} RESUME=${RESUME:-0} USE_KL_LOSS=${USE_KL_LOSS:-0} \
   MEM_FRACTION=${MEM_FRACTION:-0.45} ${HF_MODEL:+HF_MODEL=$HF_MODEL} \
   ROLLOUT_MAX_RESPONSE_LEN=${ROLLOUT_MAX_RESPONSE_LEN:-} \
   MAX_TOKENS_PER_GPU=${MAX_TOKENS_PER_GPU:-} ; \
   $PREP ; bash $W/jobs/nvfp4_driver.sh"
DRV_RC=$?
echo "$(date '+%F %T') run_det ($MODE) finished (driver rc=$DRV_RC)"
exit $DRV_RC
