+        f"[ROUTE_DEBUG r{rank}] NaN expected={n_nan_e} received={n_nan_r} | "
+        f"Inf expected={n_inf_e} received={n_inf_r}",
+        f"[ROUTE_DEBUG r{rank}] sorted weight-bit multisets equal = {multiset_equal}",
+        f"[ROUTE_DEBUG r{rank}] mismatches equal to bf16(expected) : {n_bf16_match}/{nb}",
+    ]
