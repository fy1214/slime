+"""NaN localisation probe (debug only; enabled by SLIME_NAN_PROBE=1).
+
+Installs a *global* module forward hook so we do not need a handle on the model,
+and reports only the FIRST module whose output goes NaN in a given step.
+"""
+
+import os
+
+import torch
+
+_state = {"hits": 0}
+
+
+def _first_tensor(x):
+    if torch.is_tensor(x):
+        return x
+    if isinstance(x, (tuple, list)):
+        for t in x:
+            if torch.is_tensor(t):
+                return t
+    return None
+
+
+def _hook(mod, inp, out):
+    if _state["hits"] >= int(os.environ.get("SLIME_NAN_PROBE_MAX", "8")):
+        return
+    t = _first_tensor(out)
+    if t is None or not t.is_floating_point() or t.numel() == 0:
+        return
+    if not torch.isnan(t).any():
+        return
+    ti = _first_tensor(inp)
+    in_nan = int(torch.isnan(ti).sum()) if (ti is not None and ti.is_floating_point()) else -1
+    _state["hits"] += 1
+    rank = int(os.environ.get("RANK", "-1"))
+    print(
+        f"[NANPROBE][rank{rank}] module={type(mod).__name__} "
+        f"out_shape={tuple(t.shape)} out_nan={int(torch.isnan(t).sum())} "
+        f"in_shape={tuple(ti.shape) if ti is not None else None} in_nan={in_nan}",
+        flush=True,
+    )
+
+
+def install():
+    torch.nn.modules.module.register_module_forward_hook(_hook)
+    print("[NANPROBE] global forward hook installed", flush=True)
