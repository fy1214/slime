+            f"got=0x{int(rb[j]) & 0xffffffff:08x} ({ew[j].item()!r} vs {rw[j].item()!r}) "
+            f"expert exp={int(ei[j])} got={int(ri[j])} tok={int(positions[j,0])} slot={int(positions[j,1])}"
