+def _dbg_empty(ref: torch.Tensor, shape) -> torch.Tensor:
+    """new_empty, optionally poisoned (SLIME_MOE_POISON=nan|zero).
+
+    Debug lever for "is every output row actually written?".  With `nan` any
+    row the kernels leave untouched shows up as NaN in the result; with `zero`
+    an untouched row is silently zero instead of whatever the caching allocator
+    happened to leave there.  Unset -> stock behaviour, bit-for-bit.
+    """
+    import os as _o
+
+    mode = _o.environ.get("SLIME_MOE_POISON", "")
+    if mode == "nan":
+        return ref.new_full(shape, float("nan"))
+    if mode == "zero":
+        return ref.new_zeros(shape)
+    return ref.new_empty(shape)
