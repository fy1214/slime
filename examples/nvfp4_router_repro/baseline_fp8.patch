+"""Read-only instrumentation for a single full-model optimizer step."""
+import json
+import os
+from pathlib import Path
+
+import torch
+
+from slime.backends.megatron_utils.alignment.deepgemm_forward import (
+    enable_deepgemm_all_forward,
+    enable_deepgemm_all_forward_before_train_step,
+)
+
+STATE = {'norm_events': {}, 'grad_hook_calls': {}, 'recompute': []}
+INSTALLED = False
+
+
+def rank0():
+    return torch.distributed.get_rank() == 0
+
+
+def before_log_prob(args, model, store_prefix):
+    enable_deepgemm_all_forward(args, model, store_prefix)
+
+
+def before_train(args, rollout_id, step_id, model, optimizer, scheduler):
+    global INSTALLED
+    from slime_plugins.residual_checkpoint_candidate import install
+    install()
+    enable_deepgemm_all_forward_before_train_step(args, rollout_id, step_id, model, optimizer, scheduler)
+    if INSTALLED:
+        return
+    INSTALLED = True
+    if not rank0():
+        return
+    from megatron.core import tensor_parallel
+    from megatron.core.tensor_parallel import random as tp_random
+    original_checkpoint = tensor_parallel.checkpoint
+
+    def audit_checkpoint(function, distribute, *inputs):
+        first = []
+
+        def observed(*values):
+            result = function(*values)
+            output = result[0] if isinstance(result, tuple) else result
+            if torch.is_tensor(output):
+                sample = output.detach().reshape(-1)[:1024].clone()
+                if not first:
+                    first.append(sample)
+                else:
+                    diff = (sample.float() - first[0].float()).abs()
+                    STATE['recompute'].append({'max_sample_abs_diff': diff.max().item(),
+                        'mean_sample_abs_diff': diff.mean().item(),
+                        'sample_equal_fraction': (sample == first[0]).float().mean().item()})
+            return result
+
+        return original_checkpoint(observed, distribute, *inputs)
+
+    tensor_parallel.checkpoint = audit_checkpoint
+    tp_random.checkpoint = audit_checkpoint
+    params = {}
+    for chunk_idx, chunk in enumerate(model):
+        for name, module in chunk.named_modules():
+            if not name.endswith('.input_layernorm') or not hasattr(module, 'weight'):
+                continue
+            key = f'{chunk_idx}.{name}'
+            forward = module.forward
+
+            def observed_norm(value, *a, _forward=forward, _key=key, **kw):
+                result = _forward(value, *a, **kw)
+                events = STATE['norm_events'].setdefault(_key, {})
+                tag = f'grad={torch.is_grad_enabled()},out_grad={result.requires_grad},residual={hasattr(value, "_sglang_residual_sum_fp32")}'
+                events[tag] = events.get(tag, 0) + 1
+                return result
+
+            module.forward = observed_norm
+
+            def count_grad(grad, _key=key):
+                STATE['grad_hook_calls'][_key] = STATE['grad_hook_calls'].get(_key, 0) + 1
+                return grad
+
+            module.weight.register_hook(count_grad)
+        for name, parameter in chunk.named_parameters():
+            if any(s in name for s in ('.input_layernorm.weight', '.q_norm.weight', '.k_norm.weight', '.linear_qkv.weight')):
+                params[f'{chunk_idx}.{name}'] = parameter
+
+    original_step = optimizer.step
+
+    def observed_step(*a, **kw):
+        gradient_rows = {}
+        tensors = {}
+        before = {}
+        for name, param in params.items():
+            grad = getattr(param, 'main_grad', None)
+            if grad is None:
+                grad = param.grad
+            sample = param.detach().reshape(-1)[:4096].clone()
+            before[name] = sample
+            gradient_rows[name] = {'missing_buffer': grad is None}
+            if grad is not None:
+                flat = grad.detach().float().reshape(-1)
+                gradient_rows[name].update(norm=flat.norm().item(), abs_max=flat.abs().max().item(),
+                                          finite=bool(torch.isfinite(flat).all()))
+                tensors[name + '.grad_sample'] = flat[:4096].cpu()
+        result = original_step(*a, **kw)
+        for name, param in params.items():
+            after = param.detach().reshape(-1)[:4096]
+            change = after.float() - before[name].float()
+            gradient_rows[name]['parameter_sample_change_norm'] = change.norm().item()
+            tensors[name + '.parameter_change_sample'] = change.cpu()
+        out = Path(os.environ['AUDIT_OUT'])
+        out.mkdir(parents=True, exist_ok=True)
+        report = dict(STATE, gradients=gradient_rows, variant=os.environ['AUDIT_VARIANT'],
+                      rollout_id=rollout_id, step_id=step_id)
+        (out / 'rank0.json').write_text(json.dumps(report, indent=2))
+        torch.save(tensors, out / 'rank0_samples.pt')
+        print('FULL_MODEL_BACKWARD_AUDIT', json.dumps({'variant': os.environ['AUDIT_VARIANT'],
+            'norm_modules': len(STATE['norm_events']), 'norm_weights_with_grad_hook': len(STATE['grad_hook_calls']),
+            'recompute_calls': len(STATE['recompute']), 'report': str(out / 'rank0.json')}), flush=True)
+        return result
+
+    optimizer.step = observed_step
