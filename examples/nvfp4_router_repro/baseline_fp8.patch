+def _debug_nan_source(hidden_states, topk_indices, topk_weights):
+    """Where do the NaN routes come from -- padding, or a real forward NaN?
+
+    Reports whether the NaN hidden rows form a contiguous SUFFIX (the signature of
+    Megatron's --data-pad-size-multiplier packing pad) or are scattered through the
+    batch (which would mean the model itself produced NaN and the alignment check
+    was merely the first thing to notice).
+    """
+    if _NAN_SOURCE_BUDGET[0] <= 0:
+        return
+    try:
+        rank = torch.distributed.get_rank() if torch.distributed.is_initialized() else 0
+    except Exception:
+        rank = 0
+    with torch.no_grad():
+        hs_nan_row = torch.isnan(hidden_states).any(dim=1)
+        n_rows = int(hidden_states.shape[0])
+        n_nan_rows = int(hs_nan_row.sum())
+        if n_nan_rows == 0:
+            w_nan = int(torch.isnan(topk_weights).sum())
+            if w_nan == 0:
+                return
+        _NAN_SOURCE_BUDGET[0] -= 1
+        w_nan_row = torch.isnan(topk_weights).any(dim=1)
+        n_w_nan = int(w_nan_row.sum())
+        idx = torch.nonzero(hs_nan_row, as_tuple=False).reshape(-1)
+        # Run-length structure is the real discriminator, not "is it a tail":
+        # slime pads EACH packed sequence (--data-pad-size-multiplier), so padding
+        # shows up as a handful of clean BLOCKS scattered through the buffer, never
+        # as one suffix.  A numerical blow-up instead shows up as many isolated rows.
+        runs = []
+        if idx.numel():
+            d = torch.diff(idx)
+            brk = torch.nonzero(d != 1, as_tuple=False).reshape(-1)
+            starts = torch.cat([idx[:1], idx[brk + 1]]) if brk.numel() else idx[:1]
+            ends = torch.cat([idx[brk], idx[-1:]]) if brk.numel() else idx[-1:]
+            runs = [(int(a), int(b) - int(a) + 1) for a, b in zip(starts.tolist(), ends.tolist())]
+        if idx.numel():
+            first, last = int(idx[0]), int(idx[-1])
+            # contiguous suffix <=> every row from `first` to the end is NaN
+            is_suffix = bool(hs_nan_row[first:].all()) and last == n_rows - 1
+            # fully-NaN vs partially-NaN rows
+            per_row = torch.isnan(hidden_states[idx]).float().mean(dim=1)
+            frac_full = float((per_row == 1.0).float().mean())
+        else:
+            first = last = -1
+            is_suffix, frac_full = False, 0.0
+        run_lens = [ln for _, ln in runs]
+        n_runs = len(runs)
+        n_singleton = sum(1 for ln in run_lens if ln == 1)
+        aligned = sum(1 for st, ln in runs if (st + ln) % 512 == 0 or ln % 512 == 0)
+        verdict = (
+            "PADDING BLOCKS" if n_runs and n_singleton == 0 and max(run_lens) > 8
+            else "SCATTERED SINGLETONS -> real forward NaN" if n_singleton > n_runs // 2
+            else "MIXED - inspect"
+        )
+        print(
