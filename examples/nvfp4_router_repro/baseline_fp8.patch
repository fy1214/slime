+    ni, nw, nb, nf = int(bad_i.sum()), int(bad_w.sum()), int(bad_b.sum()), int(bad_f.sum())
+    if ni == 0 and nw == 0 and nf == 0:
+        return
+    _ROUTE_DEBUG_BUDGET[0] -= 1
+
+    n_nan_e, n_nan_r = int(torch.isnan(ew).sum()), int(torch.isnan(rw).sum())
+    n_inf_e, n_inf_r = int(torch.isinf(ew).sum()), int(torch.isinf(rw).sum())
