+"""NVFP4 paired training with a synchronized first-update gradient gate."""
+import json
+import os
+from pathlib import Path
+
+import torch
+from slime.backends.megatron_utils.alignment.nvfp4_alignment import (
+    enable_nvfp4_alignment_all_forward,
+    enable_nvfp4_alignment_all_forward_before_train_step,
+)
+
+INSTALLED = False
+
+
+def before_log_prob(args, model, store_prefix):
+    enable_nvfp4_alignment_all_forward(args, model, store_prefix)
+
+
+def before_train(args, rollout_id, step_id, model, optimizer, scheduler):
+    global INSTALLED
+    variant = os.environ['AUDIT_VARIANT']
+    if variant == 'fixed':
+        from slime_plugins.residual_checkpoint_candidate import install
+        install()
+    elif variant != 'baseline':
+        raise RuntimeError(f'Unknown variant {variant}')
+    enable_nvfp4_alignment_all_forward_before_train_step(args, rollout_id, step_id, model, optimizer, scheduler)
+    if INSTALLED:
+        return
+    INSTALLED = True
+    from megatron.core import tensor_parallel
+    from megatron.core.tensor_parallel import random as tp_random
+    is_primary = torch.distributed.get_rank() == 0
+    original_checkpoint = tensor_parallel.checkpoint
+    original_step = optimizer.step
+    hooks, parameters, fired, differences = [], {}, set(), []
+    if is_primary:
+        for chunk_id, chunk in enumerate(model):
+            for name, parameter in chunk.named_parameters():
+                if name.endswith('.input_layernorm.weight'):
+                    key = f'{chunk_id}.{name}'
+                    parameters[key] = parameter
+
+                    def observe(grad, _key=key):
+                        fired.add(_key)
+                        return grad
+
+                    hooks.append(parameter.register_hook(observe))
+
+        def audit_checkpoint(function, distribute, *inputs):
+            first = []
+
+            def observed(*values):
+                result = function(*values)
+                output = result[0] if isinstance(result, tuple) else result
+                sample = output.detach().reshape(-1)[:1024].clone()
+                if not first:
+                    first.append(sample)
+                else:
+                    differences.append((sample.float() - first[0].float()).abs().max().item())
+                return result
+
+            return original_checkpoint(observed, distribute, *inputs)
+
+        tensor_parallel.checkpoint = audit_checkpoint
+        tp_random.checkpoint = audit_checkpoint
+
+    def gated_step(*a, **kw):
+        status = torch.ones((), dtype=torch.int32, device=torch.cuda.current_device())
+        if is_primary:
+            try:
+                norms = {}
+                for name, parameter in parameters.items():
+                    grad = getattr(parameter, 'main_grad', None)
+                    if grad is None:
+                        grad = parameter.grad
+                    norms[name] = None if grad is None else grad.detach().float().norm().item()
+                finite = all(v is not None and v >= 0 and v < float('inf') for v in norms.values())
+                nonzero = sum(v is not None and v > 0 for v in norms.values())
+                expected = 48 if variant == 'fixed' else 1
+                passed = len(parameters) == 48 and len(fired) == expected and nonzero == expected and finite
+                if variant == 'fixed':
+                    passed = passed and bool(differences) and all(v == 0 for v in differences)
+                report = {'variant':variant, 'rollout_id':rollout_id, 'step_id':step_id,
+                    'norm_parameters':len(parameters), 'norm_grad_hooks':len(fired),
+                    'norm_nonzero_gradients':nonzero, 'norm_gradient_l2':norms,
+                    'checkpoint_output_sample_max_differences':differences, 'passed':passed}
+                out = Path(os.environ['AUDIT_OUT'])
+                out.mkdir(parents=True, exist_ok=True)
+                (out / 'first_step_gate.json').write_text(json.dumps(report, indent=2))
+                print('NVFP4_RECOMPUTE_GATE', json.dumps({k:v for k,v in report.items()
+                    if k not in ('norm_gradient_l2', 'checkpoint_output_sample_max_differences')}), flush=True)
+                status.fill_(int(passed))
+            except Exception as exc:
+                print('NVFP4_RECOMPUTE_GATE_ERROR', repr(exc), flush=True)
+                status.zero_()
+        torch.distributed.broadcast(status, src=0)
+        if status.item() != 1:
+            raise RuntimeError('NVFP4 first-step gradient/recompute gate failed; see rank0 report')
+        result = original_step(*a, **kw)
+        optimizer.step = original_step
+        if is_primary:
+            tensor_parallel.checkpoint = original_checkpoint
+            tp_random.checkpoint = original_checkpoint
+            for handle in hooks:
+                handle.remove()
+        return result
+
+    optimizer.step = gated_step
