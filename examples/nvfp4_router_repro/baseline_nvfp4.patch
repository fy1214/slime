+def _maybe_zero_quant_scale_alloc() -> None:
+    """Zero SGLang's per-token-group scale buffer *including* its TMA alignment padding.
+
+    `create_per_token_group_quant_fp8_output_scale` allocates the UE8M0 scale as
+    `torch.empty((aligned_k // 4, aligned_mn), int32).transpose(-1,-2)[..., :x_s_mn, :]`.
+    The quant kernel writes only the un-padded region, so when `x_s_k` is not a multiple
+    of 4 the trailing UE8M0 exponent bytes are whatever the caching allocator left there.
+    Qwen3-30B-A3B's FC2 input has ffn=768 -> 6 k-blocks -> ceil_align(6,4)=8, i.e. 2 padded
+    k-blocks per row.  SGLang's own source carries
+    `# TODO(FIXME): Fix cuda kernel and recover here to empty.` at that allocation.
+
+    Enabled by SLIME_ZERO_QUANT_SCALE=1.  Zeroing costs one memset per quantization.
+    """
+    import os as _o
+
+    if _o.environ.get("SLIME_ZERO_QUANT_SCALE") != "1" or _QUANT_SCALE_ZEROED["done"]:
+        return
+    from sglang.srt.layers.quantization import fp8_kernel as _fk
+
+    _orig = _fk.create_per_token_group_quant_fp8_output_scale
+
+    def _zeroed(*args, **kwargs):
+        out = _orig(*args, **kwargs)
+        base = out
+        while base._base is not None:
+            base = base._base
+        base.zero_()
+        return out
+
+    _fk.create_per_token_group_quant_fp8_output_scale = _zeroed
+    _QUANT_SCALE_ZEROED["done"] = True
+    print("[ZEROSCALE] create_per_token_group_quant_fp8_output_scale is now zero-filled", flush=True)
