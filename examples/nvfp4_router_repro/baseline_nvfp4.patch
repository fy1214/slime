+"""Investigational fix: carry exact residual through explicit checkpoint inputs.
+
+Only applies to MCore checkpoints with a tensor carrying the aligned residual
+attribute. Forward values stay exact; backward routes the residual-boundary
+gradient through the ordinary hidden-state checkpoint input. Passing the FP32
+tensor as another differentiable path would double-count/cross checkpoint edges.
+"""
+import torch
+
+ATTRIBUTE = '_sglang_residual_sum_fp32'
+
+
+class _ExactResidualBoundary(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, hidden, exact):
+        ctx.hidden_dtype = hidden.dtype
+        return exact
+
+    @staticmethod
+    def backward(ctx, grad):
+        return grad.to(ctx.hidden_dtype), None
+
+
+def wrap_checkpoint(original):
+    def checkpoint(function, distribute_saved_activations, *args):
+        if not args or not torch.is_tensor(args[0]):
+            return original(function, distribute_saved_activations, *args)
+        exact = getattr(args[0], ATTRIBUTE, None)
+        if exact is None:
+            return original(function, distribute_saved_activations, *args)
+        if distribute_saved_activations:
+            raise RuntimeError('Residual checkpoint candidate requires undistributed saved activations')
+        if exact.shape != args[0].shape or exact.dtype != torch.float32:
+            raise RuntimeError('Unexpected aligned FP32 residual layout')
+
+        def with_residual(*extended):
+            hidden = extended[0]
+            old = getattr(hidden, ATTRIBUTE, None)
+            setattr(hidden, ATTRIBUTE, _ExactResidualBoundary.apply(hidden, extended[-1]))
+            try:
+                return function(*extended[:-1])
+            finally:
+                if old is None:
+                    delattr(hidden, ATTRIBUTE)
+                else:
+                    setattr(hidden, ATTRIBUTE, old)
+
+        return original(with_residual, distribute_saved_activations, *args, exact.detach())
+
+    return checkpoint
+
+
+def install():
+    from megatron.core import tensor_parallel
+    from megatron.core.tensor_parallel import random
+    if getattr(tensor_parallel.checkpoint, '_residual_boundary_candidate', False):
+        return
+    wrapped = wrap_checkpoint(tensor_parallel.checkpoint)
+    wrapped._residual_boundary_candidate = True
+    tensor_parallel.checkpoint = wrapped
+    random.checkpoint = wrapped
