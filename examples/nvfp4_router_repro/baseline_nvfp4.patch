+def _nan_stage(tag: str, **tensors) -> None:
+    """Debug-only stage NaN/Inf counter; prints only the stages that are dirty.
+
+    Enabled by SLIME_NAN_PROBE=1.  The earliest tag printed inside one grouped
+    forward is where the NaN is born.
+    """
+    import os as _o
+
+    # Pure-sync bisect lever: SLIME_MOE_SYNC_AT=<tag-prefix>|all inserts ONLY a
+    # device sync at the matching stage (no tensor reads), so "does a sync here
+    # fix it?" is separated from "does reading the tensor fix it?".
+    _at = _o.environ.get("SLIME_MOE_SYNC_AT", "")
+    if _at and (_at == "all" or tag.startswith(_at)):
+        torch.cuda.synchronize()
+
+    if _o.environ.get("SLIME_NAN_PROBE") != "1":
+        return
+    if _NAN_STAGE_STATE["n"] >= int(_o.environ.get("SLIME_NAN_PROBE_STAGES", "30")):
+        return
+    parts, hit = [], False
+    for k, t in tensors.items():
+        if not torch.is_tensor(t):
+            continue
+        tf = t.to(torch.float32) if t.dtype.itemsize == 1 or t.dtype == torch.bfloat16 else t
+        if not tf.is_floating_point():
+            parts.append(f"{k}=int{tuple(t.shape)}")
+            continue
+        n = int(torch.isnan(tf).sum())
+        i = int(torch.isinf(tf).sum())
+        z = int((tf == 0).all(dim=-1).sum()) if tf.ndim == 2 else -1
+        parts.append(f"{k}[{tuple(t.shape)}]nan={n},inf={i},zrows={z}")
+        hit = hit or n or i
+    if hit:
+        _NAN_STAGE_STATE["n"] += 1
+        print("[NANSTAGE] " + tag + " " + " | ".join(parts), flush=True)
+
+
